        {
          "calculate": "datum.c[floor(phase+2)%4]*(1-(phase+2)+floor(phase+2))+datum.c[(floor(phase+2)+1)%4]*((phase+2)-floor(phase+2))",
          "as": "now"
        },
        {
          "filter": "datum.now>0.5"
        },
        {
          "calculate": "(phase+2)%4",
          "as": "hue"
        },
        {
          "calculate": "['Summer','Autumn','Winter','Spring'][round(phase+2)%4]",
          "as": "season"
        },
        {
          "calculate": "round(datum.now)",
          "as": "count"
        }
      ],
      "mark": {
        "type": "circle",
        "filled": false,
        "strokeWidth": 1.1,
        "opacity": 0.75
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
