{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 904,
  "height": 620,
  "padding": 8,
  "config": {
    "background": "transparent",
    "font": "'Source Sans 3', sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "'Source Sans 3', sans-serif",
      "titleFont": "'Source Sans 3', sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#4d5347",
      "titleColor": "#24281f",
      "domain": false,
      "ticks": false,
      "gridColor": "#e0dccf",
      "gridOpacity": 0.75,
      "labelPadding": 8,
      "titlePadding": 14
    },
    "legend": {
      "labelFont": "'Source Sans 3', sans-serif",
      "titleFont": "'Source Sans 3', sans-serif",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 500,
      "labelColor": "#4d5347",
      "titleColor": "#24281f",
      "gradientThickness": 9,
      "gradientLength": 130,
      "padding": 8
    },
    "title": {
      "font": "'Source Sans 3', sans-serif",
      "color": "#24281f",
      "fontSize": 15,
      "fontWeight": 500,
      "anchor": "start"
    }
  },
  "description": "2024 observation records in one-degree squares. The control outlines the fewest squares that together hold a chosen share of all records.",
  "params": [
    {
      "name": "cover",
      "value": 0.5
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -134,
      0,
      0
    ],
    "center": [
      0,
      -28
    ]
  },
  "layer": [
    {
      "data": {
        "url": "https://wenshen18643.github.io/fit3179-fieldnotes/specs/data/half-of-all-records-come-from-12-of-720-squares-1.json"
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e8e4d9",
        "stroke": "#c7c6b8",
        "strokeWidth": 0.7
      }
    },
    {
      "data": {
        "url": "https://wenshen18643.github.io/fit3179-fieldnotes/specs/data/half-of-all-records-come-from-12-of-720-squares-2.json"
      },
      "mark": {
        "type": "geoshape",
        "stroke": "#f7f2e8",
        "strokeWidth": 0.45
      },
      "encoding": {
        "color": {
          "field": "properties.count",
          "type": "quantitative",
          "scale": {
            "type": "log",
            "domain": [
              1,
              1200000
            ],
            "range": [
              "#edf8e9",
              "#bae4b3",
              "#74c476",
              "#31a354",
              "#006d2c"
            ]
          },
          "legend": {
            "title": "Records in each 1° square",
            "orient": "bottom-left",
            "offset": 0,
            "values": [
              1,
              100,
              10000,
              1000000
            ],
            "format": ".0s",
            "gradientLength": 200
          }
        },
        "tooltip": [
          {
            "field": "properties.count",
            "title": "2024 records",
            "format": ","
          },
          {
            "field": "properties.rank",
            "title": "Busiest-square rank"
          },
          {
            "field": "properties.latitude",
            "title": "Latitude"
          },
          {
            "field": "properties.longitude",
            "title": "Longitude"
          }
        ]
      }
    },
    {
      "data": {
        "url": "https://wenshen18643.github.io/fit3179-fieldnotes/specs/data/half-of-all-records-come-from-12-of-720-squares-3.json"
      },
      "transform": [
        {
          "filter": "abs(datum.properties.cover-cover)<0.001"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#f7f2e8",
        "strokeWidth": 5,
        "strokeCap": "square"
      }
    },
    {
      "data": {
        "url": "https://wenshen18643.github.io/fit3179-fieldnotes/specs/data/half-of-all-records-come-from-12-of-720-squares-3.json"
      },
      "transform": [
        {
          "filter": "abs(datum.properties.cover-cover)<0.001"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#24281f",
        "strokeWidth": 2.2,
        "strokeCap": "square"
      }
    },
    {
      "data": {
        "url": "https://wenshen18643.github.io/fit3179-fieldnotes/specs/data/half-of-all-records-come-from-12-of-720-squares-1.json"
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#9b9d8d",
        "strokeWidth": 0.6
      }
    },
    {
      "data": {
        "values": [
          {
            "text": "Perth",
            "longitude": 115.86,
            "latitude": -31.95
          },
          {
            "text": "Melbourne",
            "longitude": 144.96,
            "latitude": -37.81
          },
          {
            "text": "Sydney",
