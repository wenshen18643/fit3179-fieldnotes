        }
      }
    },
    {
      "data": {
        "values": [
          {
            "text": "Perth",
            "longitude": 115.86,
            "latitude": -31.95
          },
          {
            "text": "Melbourne",
            "longitude": 144.96,
            "latitude": -37.81
          },
          {
            "text": "Sydney",
            "longitude": 151.21,
            "latitude": -33.87
          },
          {
            "text": "Brisbane",
            "longitude": 153.03,
            "latitude": -27.47
          },
          {
            "text": "Adelaide",
            "longitude": 138.6,
            "latitude": -34.93
          }
        ]
      },
      "mark": {
        "type": "text",
        "color": "#24281f",
        "fontSize": 11,
        "fontWeight": 600,
        "dy": 15
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "text"
        }
      }
    },
    {
      "data": {
        "url": "https://wenshen18643.github.io/fit3179-fieldnotes/specs/data/half-of-all-records-come-from-12-of-720-squares-4.json"
      },
      "transform": [
        {
          "filter": "datum.cumBefore < cover"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "n"
            }
          ]
        },
        {
          "calculate": "datum.n+' of '+720+' squares'",
          "as": "line1"
        },
        {
          "calculate": "'hold '+format(cover,'.0%')+' of all records'",
          "as": "line2"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "fontSize": 26,
            "fontWeight": 600,
            "font": "'Fraunces', serif",
            "color": "#315e4c",
            "x": 0,
            "y": 0
          },
          "encoding": {
            "text": {
              "field": "line1"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "fontSize": 14,
            "color": "#24281f",
            "x": 1,
            "y": 34
          },
          "encoding": {
            "text": {
              "field": "line2"
            }
          }
        }
      ]
    }
  ]
