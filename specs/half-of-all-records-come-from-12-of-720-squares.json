            "latitude": -27.47
          },
          {
            "text": "Adelaide",
            "longitude": 138.6,
            "latitude": -34.93
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 600,
        "dy": 15,
        "stroke": "#f7f2e8",
        "strokeWidth": 4,
        "strokeJoin": "round"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
