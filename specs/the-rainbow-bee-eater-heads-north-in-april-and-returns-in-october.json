{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "width": 844,
  "height": 476,
  "padding": {
    "left": 8,
    "right": 10,
    "top": 16,
    "bottom": 8
  },
  "background": "transparent",
  "autosize": {
    "type": "pad",
    "contains": "padding"
  },
  "config": {
    "text": {
      "font": "'Source Sans 3', sans-serif",
      "fill": "#24281f"
    },
    "axis": {
      "labelFont": "'Source Sans 3', sans-serif",
      "titleFont": "'Source Sans 3', sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#4d5347",
      "titleColor": "#24281f",
      "domain": false,
      "ticks": false,
      "gridColor": "#e0dccf",
      "gridOpacity": 0.75,
      "labelPadding": 8,
      "titlePadding": 14
    },
    "legend": {
      "labelFont": "'Source Sans 3', sans-serif",
      "titleFont": "'Source Sans 3', sans-serif",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 500,
      "labelColor": "#4d5347",
      "titleColor": "#24281f",
      "gradientThickness": 9,
      "gradientLength": 130,
      "padding": 8
    }
  },
  "description": "Monthly latitude distributions of rainbow bee-eater records. Each ridge is normalised to that month’s bee-eater records, at one-degree latitude bins. Peaks show where records concentrate, not a bird’s flight path.",
  "data": [
    {
      "name": "ridges",
      "url": "https://wenshen18643.github.io/fit3179-fieldnotes/specs/data/the-rainbow-bee-eater-heads-north-in-april-and-returns-in-october-1.json"
    },
    {
      "name": "months",
      "values": [
        {
          "month": 1,
          "label": "Jan",
          "season": "Summer",
          "count": 2655,
          "medianLatitude": -30,
          "southOf30": 1343,
          "southShare": 0.5058380414312618
        },
        {
          "month": 2,
          "label": "Feb",
          "season": "Summer",
          "count": 2045,
          "medianLatitude": -28,
          "southOf30": 943,
          "southShare": 0.46112469437652814
        },
        {
          "month": 3,
          "label": "Mar",
          "season": "Autumn",
          "count": 2367,
          "medianLatitude": -27,
          "southOf30": 607,
          "southShare": 0.25644275454161386
        },
        {
          "month": 4,
          "label": "Apr",
          "season": "Autumn",
          "count": 2196,
          "medianLatitude": -19,
          "southOf30": 29,
          "southShare": 0.013205828779599272
        },
        {
          "month": 5,
          "label": "May",
          "season": "Autumn",
          "count": 2469,
          "medianLatitude": -18,
          "southOf30": 6,
          "southShare": 0.002430133657351154
        },
        {
          "month": 6,
          "label": "Jun",
          "season": "Winter",
          "count": 3254,
          "medianLatitude": -18,
          "southOf30": 5,
          "southShare": 0.0015365703749231714
        },
        {
          "month": 7,
          "label": "Jul",
          "season": "Winter",
          "count": 3653,
          "medianLatitude": -17,
          "southOf30": 9,
          "southShare": 0.0024637284423761293
        },
        {
          "month": 8,
          "label": "Aug",
          "season": "Winter",
          "count": 3757,
          "medianLatitude": -18,
          "southOf30": 96,
          "southShare": 0.025552302368911366
        },
        {
          "month": 9,
          "label": "Sep",
          "season": "Spring",
          "count": 3724,
          "medianLatitude": -19,
          "southOf30": 444,
          "southShare": 0.11922663802363051
        },
        {
          "month": 10,
          "label": "Oct",
          "season": "Spring",
          "count": 5620,
          "medianLatitude": -28,
          "southOf30": 2307,
          "southShare": 0.4104982206405694
        },
        {
          "month": 11,
          "label": "Nov",
          "season": "Spring",
          "count": 3567,
          "medianLatitude": -30,
          "southOf30": 1784,
          "southShare": 0.5001401738155312
        },
        {
          "month": 12,
          "label": "Dec",
          "season": "Summer",
          "count": 2392,
          "medianLatitude": -29,
          "southOf30": 1139,
          "southShare": 0.4761705685618729
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "linear",
      "domain": [
        -44,
        -10
      ],
      "range": "width",
      "nice": false,
      "zero": false
    },
    {
      "name": "season",
      "type": "ordinal",
      "domain": [
        "Summer",
        "Autumn",
        "Winter",
        "Spring"
      ],
      "range": [
        "#b0782c",
        "#8c5a86",
        "#557784",
        "#58723e"
      ]
    },
    {
      "name": "tickKey",
      "type": "ordinal",
      "domain": [
        "Middle of the month’s records: half lie south of the triangle"
      ],
      "range": [
        "triangle-up"
      ]
    }
  ],
  "legends": [
    {
      "fill": "season",
      "orient": "none",
      "direction": "horizontal",
      "legendX": -38,
      "legendY": 526,
      "title": "Season",
      "symbolType": "circle",
      "symbolSize": 80,
      "columns": 4,
      "columnPadding": 20,
      "encode": {
        "labels": {
          "update": {
            "text": {
              "signal": "datum.value+' · '+{'Summer':'Dec–Feb','Autumn':'Mar–May','Winter':'Jun–Aug','Spring':'Sep–Nov'}[datum.value]"
            }
          }
        }
      }
    },
    {
      "shape": "tickKey",
      "orient": "none",
      "legendX": -38,
      "legendY": 574,
      "symbolFillColor": "#24281f",
      "symbolStrokeColor": "#24281f",
      "symbolSize": 46,
      "labelLimit": 420
    }
  ],
  "axes": [
    {
      "orient": "bottom",
      "scale": "x",
      "values": [
        -40,
        -35,
        -30,
        -25,
        -20,
        -15,
        -10
      ],
      "title": null,
      "encode": {
        "labels": {
          "update": {
            "text": {
              "signal": "abs(datum.value)+'°S'"
            }
          }
        }
      }
    }
  ],
  "marks": [
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {
            "value": 0
          },
          "y": {
            "signal": "height+34"
          },
          "text": {
            "value": "← South"
          },
          "align": {
            "value": "left"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": 500
          },
          "fill": {
            "value": "#24281f"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {
            "signal": "width"
          },
          "y": {
            "signal": "height+34"
          },
          "text": {
            "value": "North →"
          },
          "align": {
            "value": "right"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": 500
          },
          "fill": {
            "value": "#24281f"
          }
        }
      }
    },
    {
      "type": "rule",
      "encode": {
        "enter": {
          "x": {
            "scale": "x",
            "value": -30
          },
          "y": {
            "value": 0
          },
          "y2": {
            "value": 456
          },
          "stroke": {
            "value": "#4d5347"
          },
          "strokeDash": {
            "value": [
              3,
              5
            ]
          },
          "strokeOpacity": {
            "value": 0.5
          }
        }
      }
    },
    {
      "type": "group",
      "from": {
        "facet": {
          "name": "series",
          "data": "ridges",
          "groupby": [
            "month",
            "season"
          ]
        }
      },
      "encode": {
        "enter": {
          "y": {
            "signal": "(datum.month-1)*32+28"
          },
          "height": {
            "value": 32
          },
          "width": {
            "signal": "width"
          }
        }
      },
      "marks": [
        {
          "type": "rule",
          "encode": {
            "enter": {
              "x": {
                "value": 0
              },
              "x2": {
                "signal": "width"
              },
              "y": {
                "value": 32
              },
              "stroke": {
                "value": "#d9d1bf"
              },
              "strokeWidth": {
                "value": 0.6
              }
            }
          }
        },
        {
          "type": "area",
          "from": {
            "data": "series"
          },
          "sort": {
            "field": "datum.latitude"
          },
          "encode": {
            "enter": {
              "x": {
                "scale": "x",
                "field": "latitude"
              },
              "y": {
                "signal": "32-datum.share*304"
              },
              "y2": {
                "value": 32
              },
              "fill": {
                "scale": "season",
                "field": "season"
              },
              "fillOpacity": {
                "value": 0.72
              },
              "stroke": {
                "scale": "season",
                "field": "season"
              },
              "strokeWidth": {
                "value": 1.25
              },
              "interpolate": {
                "value": "monotone"
              }
            }
          }
        },
        {
          "type": "symbol",
          "from": {
            "data": "series"
          },
          "encode": {
            "enter": {
              "x": {
                "scale": "x",
                "field": "latitude"
              },
              "y": {
                "signal": "32-datum.share*304"
              },
              "size": {
                "value": 90
              },
              "fill": {
                "value": "transparent"
              },
              "tooltip": {
                "signal": "{'Month':datum.label,'Latitude':abs(datum.latitude)+'°S','Bee-eater records':format(datum.count,','),'Share of month':format(datum.share,'.1%')}"
              }
            }
          }
        }
      ]
    },
    {
      "type": "symbol",
      "from": {
        "data": "months"
      },
      "encode": {
        "enter": {
          "x": {
            "scale": "x",
            "field": "medianLatitude"
          },
          "y": {
            "signal": "datum.month*32+28+1"
          },
          "shape": {
            "value": "triangle-up"
          },
          "size": {
            "value": 46
          },
          "fill": {
            "value": "#24281f"
          },
          "tooltip": {
            "signal": "{'Month':datum.label,'Half of records lie south of':abs(datum.medianLatitude)+'°S'}"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "months"
      },
      "encode": {
        "enter": {
          "x": {
            "value": -10
          },
          "y": {
            "signal": "(datum.month-1)*32+57"
          },
          "text": {
            "field": "label"
          },
          "align": {
            "value": "right"
          },
          "fontSize": {
            "value": 12
          }
        }
      }
    }
  ]
}
