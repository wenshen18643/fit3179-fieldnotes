  "legends": [
    {
      "fill": "records",
      "type": "gradient",
      "direction": "horizontal",
      "orient": "none",
      "legendX": 0,
      "legendY": 544,
      "title": "2024 bird records in the state",
      "values": [
        500000,
        1000000,
        1500000,
