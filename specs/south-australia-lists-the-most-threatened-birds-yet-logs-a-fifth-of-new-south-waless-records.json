{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "width": 904,
  "height": 598,
  "padding": 8,
  "background": "transparent",
  "autosize": {
    "type": "pad",
    "contains": "padding"
  },
  "config": {
    "text": {
      "font": "'Source Sans 3', sans-serif",
      "fill": "#24281f"
    },
    "axis": {
      "labelFont": "'Source Sans 3', sans-serif",
      "titleFont": "'Source Sans 3', sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#4d5347",
      "titleColor": "#24281f",
      "domain": false,
      "ticks": false,
      "gridColor": "#e0dccf",
      "gridOpacity": 0.75,
      "labelPadding": 8,
      "titlePadding": 14
    },
    "legend": {
      "labelFont": "'Source Sans 3', sans-serif",
      "titleFont": "'Source Sans 3', sans-serif",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 500,
      "labelColor": "#4d5347",
      "titleColor": "#24281f",
      "gradientThickness": 9,
      "gradientLength": 130,
      "padding": 8
    }
  },
  "description": "Dorling cartogram of the eight states and territories. Circle area is proportional to the number of nationally listed threatened bird taxa associated with the jurisdiction; colour lightness shows its 2024 bird records. Select a circle to highlight its combinations in the overlap chart.",
  "signals": [
    {
      "name": "picked",
      "value": "",
      "on": [
        {
          "events": "symbol:click",
          "update": "picked===datum.code?'':datum.code"
        },
        {
          "events": "dblclick",
          "update": "''"
        }
      ]
    }
  ],
  "projections": [
    {
      "name": "projection",
      "type": "conicEqualArea",
      "parallels": [
        -18,
        -36
      ],
      "rotate": [
        -134,
        0,
        0
      ],
      "center": [
        0,
        -28
      ],
      "fit": {
        "signal": "data('states')"
      },
      "size": [
        904,
        462
      ]
    }
  ],
  "scales": [
    {
      "name": "records",
      "type": "linear",
      "domain": [
        300000,
        2500000
      ],
      "range": [
        "#bae4b3",
        "#006d2c"
      ],
      "clamp": true
    }
  ],
  "data": [
    {
      "name": "states",
      "url": "https://wenshen18643.github.io/fit3179-fieldnotes/specs/data/half-of-all-records-come-from-12-of-720-squares-1.json"
    },
    {
      "name": "sizeKey",
      "values": [
        {
          "v": 85,
          "r": 69.3
        },
        {
          "v": 50,
          "r": 53.150673727122765
        },
        {
          "v": 20,
          "r": 33.61543763003575
        }
      ]
    },
    {
      "name": "nodes",
      "values": [
        {
          "code": "WA",
          "state": "Western Australia",
          "count": 706605,
          "listed": 64,
          "longitude": 122,
          "latitude": -26,
          "r": 60.13312290733148
        },
        {
          "code": "NT",
          "state": "Northern Territory",
          "count": 330199,
          "listed": 38,
          "longitude": 133.3,
          "latitude": -19.5,
          "r": 46.335683111526095
        },
        {
          "code": "SA",
          "state": "South Australia",
          "count": 490319,
          "listed": 85,
          "longitude": 135,
          "latitude": -30.5,
          "r": 69.3
        },
        {
          "code": "QLD",
          "state": "Queensland",
          "count": 2335374,
          "listed": 72,
          "longitude": 145,
          "latitude": -23,
          "r": 63.78080847254732
        },
        {
          "code": "NSW",
          "state": "New South Wales",
          "count": 2455993,
          "listed": 81,
          "longitude": 147,
          "latitude": -32.2,
          "r": 67.64976327074793
        },
        {
          "code": "VIC",
          "state": "Victoria",
          "count": 2450501,
          "listed": 71,
          "longitude": 144,
          "latitude": -37,
          "r": 63.336337493249665
        },
        {
          "code": "TAS",
          "state": "Tasmania",
          "count": 463068,
          "listed": 57,
          "longitude": 146.5,
          "latitude": -42,
          "r": 56.74939025326745
        },
        {
          "code": "ACT",
          "state": "Australian Capital Territory",
          "count": 343863,
          "listed": 20,
          "longitude": 149.05,
          "latitude": -35.45,
          "r": 33.61543763003575
        }
      ],
      "transform": [
        {
          "type": "formula",
          "expr": "scale('projection',[datum.longitude,datum.latitude])[0]",
          "as": "tx"
        },
        {
          "type": "formula",
          "expr": "scale('projection',[datum.longitude,datum.latitude])[1]",
          "as": "ty"
        },
        {
          "type": "formula",
          "expr": "datum.tx",
          "as": "x"
        },
        {
          "type": "formula",
          "expr": "datum.ty",
          "as": "y"
        },
        {
          "type": "force",
          "static": true,
          "iterations": 300,
          "forces": [
            {
              "force": "collide",
              "radius": {
                "expr": "datum.r+3"
              },
              "strength": 1,
              "iterations": 6
            },
            {
              "force": "x",
              "x": "tx",
              "strength": 0.05
            },
            {
              "force": "y",
              "y": "ty",
              "strength": 0.05
            }
          ]
        },
        {
          "type": "formula",
          "expr": "clamp(datum.x,datum.r+2,width-datum.r-2)",
          "as": "x"
        },
        {
          "type": "formula",
          "expr": "min(datum.y,528-datum.r)",
          "as": "y"
        }
      ]
    }
  ],
  "marks": [
    {
      "type": "shape",
      "from": {
        "data": "states"
      },
      "encode": {
        "enter": {
          "fill": {
            "value": "#ebe7dc"
          },
          "stroke": {
            "value": "#d5d0c1"
          },
          "strokeWidth": {
            "value": 0.7
          }
        }
      },
      "transform": [
        {
          "type": "geoshape",
          "projection": "projection"
        }
      ]
    },
    {
      "type": "text",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "value": 1
          },
          "y": {
            "signal": "532-20-138.6"
          },
          "baseline": {
            "value": "top"
          },
          "text": {
            "value": "Threatened birds listed"
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "value": 500
          },
          "fill": {
            "value": "#24281f"
          }
        }
      }
    },
    {
      "type": "symbol",
      "interactive": false,
      "from": {
        "data": "sizeKey"
      },
      "encode": {
        "update": {
          "x": {
            "value": 70.3
          },
          "y": {
            "signal": "532-datum.r"
          },
          "size": {
            "signal": "4*datum.r*datum.r"
          },
          "fill": {
            "value": "transparent"
          },
          "stroke": {
            "value": "#8a8f80"
          },
          "strokeWidth": {
            "value": 1
          }
        }
      }
    },
    {
      "type": "rule",
      "interactive": false,
      "from": {
        "data": "sizeKey"
      },
      "encode": {
        "update": {
          "x": {
            "value": 70.3
          },
          "x2": {
            "value": 147.6
          },
          "y": {
            "signal": "532-2*datum.r"
          },
          "stroke": {
            "value": "#b5b2a5"
          },
          "strokeDash": {
            "value": [
              2,
              2
            ]
          }
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "from": {
        "data": "sizeKey"
      },
      "encode": {
        "update": {
          "x": {
            "value": 151.6
          },
          "y": {
            "signal": "532-2*datum.r"
          },
          "baseline": {
            "value": "middle"
          },
          "text": {
            "field": "v"
          },
          "fontSize": {
            "value": 11
          },
          "fill": {
            "value": "#4d5347"
          }
        }
      }
    },
    {
      "type": "symbol",
      "from": {
        "data": "nodes"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x"
          },
          "y": {
            "field": "y"
          },
          "size": {
            "signal": "4*datum.r*datum.r"
          },
          "cursor": {
            "value": "pointer"
          },
          "fill": {
            "scale": "records",
            "field": "count"
          },
          "fillOpacity": {
            "signal": "picked===''||picked===datum.code?1:.35"
          },
          "stroke": {
            "signal": "picked===datum.code?'#24281f':'#f7f2e8'"
          },
          "strokeWidth": {
            "signal": "picked===datum.code?2.5:1.5"
          },
          "tooltip": {
            "signal": "{'Jurisdiction':datum.state,'Listed threatened bird taxa':datum.listed,'2024 bird records':format(datum.count,',')}"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "nodes"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "field": "x"
          },
          "y": {
            "signal": "datum.y-6"
          },
          "text": {
            "field": "code"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "fontSize": {
            "signal": "datum.r>26?12:11"
          },
          "fontWeight": {
            "value": 700
          },
          "fill": {
            "signal": "(picked===''||picked===datum.code)&&luminance(scale('records',datum.count))<0.22?'#ffffff':'#24281f'"
          },
          "stroke": {
            "signal": "(picked===''||picked===datum.code)&&luminance(scale('records',datum.count))<0.22?scale('records',datum.count):'#f7f2e8'"
          },
          "strokeWidth": {
            "value": 3.5
          },
          "strokeJoin": {
            "value": "round"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "nodes"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "field": "x"
          },
          "y": {
            "signal": "datum.y+8"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "text": {
            "signal": "datum.r>26?datum.listed+' listed':datum.listed"
          },
          "fontSize": {
            "signal": "datum.r>26?11:10"
          },
          "fill": {
            "signal": "(picked===''||picked===datum.code)&&luminance(scale('records',datum.count))<0.22?'#ffffff':'#24281f'"
          },
          "stroke": {
            "signal": "(picked===''||picked===datum.code)&&luminance(scale('records',datum.count))<0.22?scale('records',datum.count):'#f7f2e8'"
          },
          "strokeWidth": {
            "value": 3.5
          },
          "strokeJoin": {
            "value": "round"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "nodes"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "field": "x"
          },
          "y": {
            "signal": "datum.y+21"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "text": {
            "signal": "indexof(['SA','NSW'],datum.code)>=0?format(datum.count,'.3s')+' records':''"
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "signal": "(picked===''||picked===datum.code)&&luminance(scale('records',datum.count))<0.22?'#ffffff':'#24281f'"
          },
          "stroke": {
            "signal": "(picked===''||picked===datum.code)&&luminance(scale('records',datum.count))<0.22?scale('records',datum.count):'#f7f2e8'"
          },
          "strokeWidth": {
            "value": 3.5
          },
          "strokeJoin": {
            "value": "round"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "nodes"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "field": "x"
          },
          "y": {
            "signal": "datum.y-6"
          },
          "text": {
            "field": "code"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "fontSize": {
            "signal": "datum.r>26?12:11"
          },
          "fontWeight": {
            "value": 700
          },
          "fill": {
            "signal": "(picked===''||picked===datum.code)&&luminance(scale('records',datum.count))<0.22?'#ffffff':'#24281f'"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "nodes"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "field": "x"
          },
          "y": {
            "signal": "datum.y+8"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "text": {
            "signal": "datum.r>26?datum.listed+' listed':datum.listed"
          },
          "fontSize": {
            "signal": "datum.r>26?11:10"
          },
          "fill": {
            "signal": "(picked===''||picked===datum.code)&&luminance(scale('records',datum.count))<0.22?'#ffffff':'#24281f'"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "nodes"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "field": "x"
          },
          "y": {
            "signal": "datum.y+21"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "text": {
            "signal": "indexof(['SA','NSW'],datum.code)>=0?format(datum.count,'.3s')+' records':''"
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "signal": "(picked===''||picked===datum.code)&&luminance(scale('records',datum.count))<0.22?'#ffffff':'#24281f'"
