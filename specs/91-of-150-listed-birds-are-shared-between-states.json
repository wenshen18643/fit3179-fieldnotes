{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "width": 854,
  "height": 576,
  "padding": {
    "left": 8,
    "right": 10,
    "top": 20,
    "bottom": 18
  },
  "background": "transparent",
  "autosize": {
    "type": "pad",
    "contains": "padding"
  },
  "config": {
    "text": {
      "font": "'Source Sans 3', sans-serif",
      "fill": "#24281f"
    },
    "axis": {
      "labelFont": "'Source Sans 3', sans-serif",
      "titleFont": "'Source Sans 3', sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#4d5347",
      "titleColor": "#24281f",
      "domain": false,
      "ticks": false,
      "gridColor": "#e0dccf",
      "gridOpacity": 0.75,
      "labelPadding": 8,
      "titlePadding": 14
    },
    "legend": {
      "labelFont": "'Source Sans 3', sans-serif",
      "titleFont": "'Source Sans 3', sans-serif",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 500,
      "labelColor": "#4d5347",
      "titleColor": "#24281f",
      "gradientThickness": 9,
      "gradientLength": 130,
      "padding": 8
    }
  },
  "description": "An UpSet chart of the exact state combinations that each hold four or more of the 150 extant threatened bird taxa listed by DCCEEW in the eight jurisdictions. A connected column is an exact combination of states, and the bar above counts listed taxa in it.",
  "signals": [
    {
      "name": "picked",
      "value": "",
      "on": [
        {
          "events": "@rowlabel:click",
          "update": "picked===datum.code?'':datum.code"
        }
      ]
    }
  ],
