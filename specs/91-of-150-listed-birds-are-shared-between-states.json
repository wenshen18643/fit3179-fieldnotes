          "row": 6
        },
        {
          "code": "ACT",
          "row": 7
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "band",
      "domain": {
        "data": "bars",
        "field": "id"
      },
      "range": "width",
      "padding": 0.28
    },
    {
      "name": "y",
      "type": "linear",
      "domain": [
        0,
        23.18
      ],
      "range": [
        220,
        32
      ],
      "zero": true
    },
    {
      "name": "dotKey",
      "type": "ordinal",
      "domain": [
        "state in the group",
        "state not in the group"
      ],
      "range": [
        "#24281f",
        "#ebe7dc"
      ]
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "codes"
      },
      "encode": {
        "update": {
          "x": {
            "value": -40
          },
          "x2": {
            "signal": "width"
          },
          "y": {
            "signal": "258+datum.row*36-16.2"
          },
          "height": {
            "value": 32.4
          },
          "fill": {
            "value": "#efe3dc"
          },
          "opacity": {
            "signal": "picked===datum.code?1:0"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "bars"
      },
      "encode": {
        "enter": {
          "x": {
            "scale": "x",
            "field": "id"
          },
          "width": {
            "scale": "x",
            "band": 1
          },
          "y": {
            "scale": "y",
            "field": "count"
          },
          "y2": {
            "value": 220
          },
          "tooltip": {
            "signal": "{'Exactly these states':datum.combination,'Listed bird taxa':datum.count}"
          }
        },
        "update": {
          "fill": {
            "signal": "picked==='' || indexof(datum.states,picked)>=0?'#a74735':'#e6d8d2'"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "bars"
      },
      "encode": {
        "enter": {
          "x": {
            "scale": "x",
            "field": "id",
            "band": 0.5
          },
          "y": {
            "scale": "y",
            "field": "count",
            "offset": -7
          },
          "text": {
            "field": "count"
          },
          "align": {
            "value": "center"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": 600
          }
        },
        "update": {
          "fill": {
            "signal": "picked==='' || indexof(datum.states,picked)>=0?'#24281f':'#4d5347'"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "bars"
      },
      "encode": {
        "enter": {
          "x": {
            "scale": "x",
            "field": "id",
            "band": 0
          },
          "y": {
            "scale": "y",
            "field": "count",
            "offset": -24
          },
          "align": {
            "value": "left"
          },
          "fontSize": {
            "value": 11
          },
          "fontStyle": {
            "value": "italic"
          },
          "fill": {
            "value": "#4d5347"
          },
          "text": {
            "signal": "datum.states.length===1&&datum.id===0?'only '+datum.states[0]:datum.id===1?'shared by '+datum.states.length:''"
          }
        }
      }
    },
    {
      "type": "rule",
      "encode": {
        "enter": {
          "x": {
            "value": 0
          },
          "x2": {
            "signal": "width"
          },
          "y": {
            "value": 237
          },
          "stroke": {
            "value": "#d9d1bf"
          }
        }
      }
    },
    {
      "type": "rule",
      "from": {
        "data": "links"
      },
      "encode": {
        "enter": {
          "x": {
            "scale": "x",
            "field": "id",
            "band": 0.5
          },
          "y": {
            "signal": "258+datum.min*36"
          },
          "y2": {
            "signal": "258+datum.max*36"
          },
          "strokeWidth": {
            "value": 1.5
          }
        },
        "update": {
          "stroke": {
            "signal": "picked==='' || indexof(datum.states,picked)>=0?'#24281f':'#aaa699'"
          }
        }
      }
    },
    {
      "type": "symbol",
      "from": {
        "data": "matrix"
      },
      "encode": {
        "enter": {
          "x": {
            "scale": "x",
            "field": "id",
            "band": 0.5
          },
          "y": {
            "signal": "258+datum.row*36"
          },
          "size": {
            "value": 54
          },
          "tooltip": {
            "signal": "{'Exactly these states':datum.combination,'Listed bird taxa':datum.count,'State':datum.code,'Included':datum.active?'Yes':'No'}"
          }
        },
        "update": {
          "fill": {
            "signal": "!datum.active?'#ebe7dc':picked==='' || indexof(datum.states,picked)>=0?'#24281f':'#aaa699'"
          }
        }
      }
    },
    {
      "type": "text",
      "name": "rowlabel",
      "from": {
        "data": "codes"
      },
      "encode": {
        "enter": {
          "x": {
            "value": -12
          },
          "y": {
            "signal": "258+datum.row*36"
          },
          "text": {
            "field": "code"
          },
          "align": {
            "value": "right"
          },
          "baseline": {
            "value": "middle"
          },
          "cursor": {
            "value": "pointer"
          }
        },
        "update": {
          "fontSize": {
            "signal": "picked===datum.code?13:11"
          },
          "fontWeight": {
            "signal": "picked===datum.code?700:400"
          },
          "fill": {
            "signal": "picked===datum.code?'#a74735':'#24281f'"
          }
        }
      }
    }
  ],
  "legends": [
    {
      "fill": "dotKey",
      "orient": "none",
      "direction": "horizontal",
      "legendX": -40,
      "legendY": 532,
      "symbolType": "circle",
      "symbolSize": 54,
      "columnPadding": 18
    }
  ]
}
