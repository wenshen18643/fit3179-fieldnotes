{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "width": 850,
  "height": 370,
  "padding": {
    "left": 24,
    "right": 20,
    "top": 6,
    "bottom": 50
  },
  "background": "transparent",
  "autosize": {
    "type": "pad",
    "contains": "padding"
  },
  "config": {
    "text": {
      "font": "'Source Sans 3', sans-serif",
      "fill": "#24281f"
    },
    "axis": {
      "labelFont": "'Source Sans 3', sans-serif",
      "titleFont": "'Source Sans 3', sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#4d5347",
      "titleColor": "#24281f",
      "domain": false,
      "ticks": false,
      "gridColor": "#e0dccf",
      "gridOpacity": 0.75,
      "labelPadding": 8,
      "titlePadding": 14
    },
    "legend": {
      "labelFont": "'Source Sans 3', sans-serif",
      "titleFont": "'Source Sans 3', sans-serif",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 500,
      "labelColor": "#4d5347",
      "titleColor": "#24281f",
      "gradientThickness": 9,
      "gradientLength": 130,
      "padding": 8
    }
  },
  "description": "Beeswarm showing the record counts of 69 nationally threatened, species-level birds whose scientific names match between ALA and DCCEEW, four of them under newer genus names. Every dot is a species. Unmatched names and listed subspecies are excluded, not treated as zero.",
  "data": [
    {
      "name": "birds",
      "url": "https://wenshen18643.github.io/fit3179-fieldnotes/specs/data/some-threatened-birds-are-logged-thousands-of-times-others-a-handful-1.json"
    },
    {
