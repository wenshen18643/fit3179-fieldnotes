    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "log",
      "domain": [
        1,
        15000
      ],
      "range": "width",
      "nice": false
    },
    {
      "name": "color",
      "type": "ordinal",
      "domain": [
        "Vulnerable",
        "Endangered",
        "Critically Endangered"
      ],
      "range": [
        "#ef6548",
        "#d7301f",
        "#990000"
      ]
    }
  ],
  "axes": [
    {
      "scale": "x",
      "orient": "bottom",
      "values": [
        1,
        10,
        100,
        1000,
        10000
      ],
      "format": ",",
      "title": "2024 records per species · logarithmic scale",
      "grid": true,
      "gridColor": "#ebe5d8"
    }
  ],
  "marks": [
    {
      "type": "rule",
      "from": {
        "data": "bands"
      },
      "encode": {
        "enter": {
          "x": {
            "value": 0
          },
          "x2": {
            "signal": "width"
          },
          "y": {
            "field": "y"
          },
          "stroke": {
            "value": "#d9d1bf"
          },
          "strokeWidth": {
            "value": 0.7
          }
        }
      }
    },
    {
      "type": "symbol",
      "from": {
        "data": "bands"
      },
      "interactive": false,
      "encode": {
        "enter": {
          "x": {
            "value": 12
          },
          "y": {
            "field": "labelY"
          },
          "size": {
            "value": 64
          },
          "fill": {
            "scale": "color",
            "field": "status"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "bands"
      },
      "encode": {
        "enter": {
          "x": {
            "value": 22
          },
          "y": {
            "field": "labelY"
          },
          "baseline": {
            "value": "middle"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#24281f"
          },
          "text": {
            "signal": "datum.status+' · '+datum.n"
          }
        }
      }
    },
    {
      "type": "symbol",
      "from": {
        "data": "birds"
      },
      "encode": {
        "enter": {
          "x": {
            "scale": "x",
            "field": "count"
          },
          "y": {
            "field": "cy"
          },
          "fill": {
            "scale": "color",
            "field": "status"
          },
          "stroke": {
            "value": "#f7f2e8"
          },
          "strokeWidth": {
            "value": 1
          },
          "tooltip": {
            "signal": "{'Bird':datum.name,'Scientific name':datum.recordedAs?datum.scientific+' (recorded as '+datum.recordedAs+')':datum.scientific,'Listing in Aug 2026':datum.status,'2024 records':format(datum.count,',')}"
          }
        },
        "update": {
          "size": {
            "value": 101
          },
          "stroke": {
            "value": "#f7f2e8"
          }
        },
        "hover": {
          "size": {
            "value": 202
          },
          "stroke": {
            "value": "#24281f"
          }
        }
      }
    },
    {
      "type": "rule",
      "from": {
        "data": "notes"
      },
      "interactive": false,
      "encode": {
        "enter": {
          "x": {
            "scale": "x",
            "field": "count"
          },
          "y": {
            "field": "y1"
          },
          "y2": {
            "field": "y2"
          },
          "stroke": {
            "value": "#24281f"
          },
          "strokeWidth": {
            "value": 1
          },
          "opacity": {
            "signal": "datum.y2>datum.y1+2?1:0"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "notes"
      },
      "interactive": false,
      "encode": {
        "enter": {
          "x": {
            "scale": "x",
            "field": "count",
            "offset": {
              "field": "dx"
            }
          },
          "y": {
            "field": "ny"
          },
          "align": {
            "field": "align"
          },
          "baseline": {
            "field": "baseline"
          },
          "lineHeight": {
            "value": 15
          },
          "text": {
            "field": "text"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#24281f"
          }
        }
      }
    }
  ]
}
