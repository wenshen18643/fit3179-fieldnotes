          "status": "Endangered",
          "count": 8201,
          "profile": "http://www.environment.gov.au/cgi-bin/sprat/public/publicspecies.pl?taxon_id=768",
          "cy": 212.05333333333334,
          "centre": 212.05333333333334,
          "lo": -28.253333333333337,
          "hi": 28.253333333333337,
