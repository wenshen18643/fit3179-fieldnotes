{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "padding": 8,
  "config": {
    "background": "transparent",
    "font": "'Source Sans 3', sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "'Source Sans 3', sans-serif",
      "titleFont": "'Source Sans 3', sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#4d5347",
      "titleColor": "#24281f",
      "domain": false,
      "ticks": false,
      "gridColor": "#e0dccf",
      "gridOpacity": 0.75,
      "labelPadding": 8,
      "titlePadding": 14
    },
    "legend": {
      "labelFont": "'Source Sans 3', sans-serif",
      "titleFont": "'Source Sans 3', sans-serif",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 500,
      "labelColor": "#4d5347",
      "titleColor": "#24281f",
      "gradientThickness": 9,
      "gradientLength": 130,
      "padding": 8
    },
    "title": {
      "font": "'Source Sans 3', sans-serif",
      "color": "#24281f",
      "fontSize": 15,
      "fontWeight": 500,
      "anchor": "start"
    }
  },
  "description": "Monthly share of all records for eight featured species, divided by each species’ annual share. One means the species occupies its typical share. Rows are grouped into birds whose share swings through the year and birds recorded steadily all year. The colour scale matches the circular heatmap beside it. This adjusts for total monthly record volume, not survey effort.",
  "data": {
    "url": "https://wenshen18643.github.io/fit3179-fieldnotes/specs/data/some-birds-come-and-go-others-stay-all-year-1.json"
  },
  "spacing": 30,
  "vconcat": [
    {
      "title": {
        "text": "Share swings with the seasons",
        "anchor": "start",
        "orient": "top",
        "offset": 6,
        "fontSize": 13,
        "fontWeight": 600,
        "color": "#24281f",
        "font": "'Source Sans 3', sans-serif"
      },
      "width": 730,
      "height": {
        "step": 54
      },
      "transform": [
        {
          "filter": {
            "field": "group",
            "equal": "Share swings with the seasons"
          }
        }
      ],
      "encoding": {
        "x": {
          "field": "label",
          "type": "ordinal",
          "sort": [
            "Jan",
            "Feb",
            "Mar",
            "Apr",
            "May",
            "Jun",
            "Jul",
            "Aug",
            "Sep",
            "Oct",
            "Nov",
            "Dec"
          ],
          "axis": null
        },
        "y": {
          "field": "name",
          "type": "ordinal",
          "sort": [
            "White-throated Needletail",
            "Eastern Koel",
            "Red-necked Stint",
            "Rainbow Bee-eater",
            "Silvereye",
            "Welcome Swallow",
            "Superb Fairy-wren",
            "Australian Magpie"
          ],
          "axis": {
            "title": null,
            "labelLimit": 210,
            "labelFontSize": 12
          }
        }
      },
      "layer": [
        {
          "mark": {
            "type": "rect",
            "stroke": "#f7f2e8",
            "strokeWidth": 2,
            "cornerRadius": 1
          },
          "encoding": {
            "color": {
              "field": "relative",
              "type": "quantitative",
              "scale": {
                "type": "log",
                "domain": [
                  0.5,
                  1,
                  2
                ],
                "range": [
                  "#d01c8b",
                  "#f7f7f7",
                  "#4dac26"
                ],
                "clamp": true
              },
              "legend": {
                "title": "Share of the month’s records, compared with the bird’s usual share",
                "titleLimit": 880,
                "orient": "none",
                "direction": "horizontal",
                "legendX": -146,
                "legendY": 550,
                "values": [
                  0.5,
                  1,
                  2
                ],
                "labelExpr": "datum.value===1?'usual':datum.value<1?'half or less':'double or more'",
                "gradientLength": 220
              }
            },
            "tooltip": [
              {
                "field": "name",
                "title": "Bird"
              },
              {
                "field": "label",
                "title": "Month"
              },
              {
                "field": "count",
                "title": "Records",
                "format": ","
              },
              {
                "field": "per10k",
                "title": "Per 10,000 bird records",
                "format": ".1f"
              },
              {
                "field": "relative",
                "title": "Relative to annual share",
                "format": ".2f"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "dx": 30.416666666666668,
            "fontSize": 11,
            "fontWeight": 600,
            "lineHeight": 13,
            "color": "#ffffff",
            "stroke": "#d01c8b",
            "strokeWidth": 4,
            "strokeJoin": "round"
          },
          "encoding": {
            "text": {
              "field": "note"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "dx": 30.416666666666668,
            "fontSize": 11,
            "fontWeight": 600,
            "lineHeight": 13,
            "color": "#ffffff"
          },
          "encoding": {
            "text": {
              "field": "note"
            }
          }
        }
      ]
    },
