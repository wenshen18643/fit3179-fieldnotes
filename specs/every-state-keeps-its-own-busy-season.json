{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "width": 904,
  "height": 576,
  "padding": 8,
  "background": "transparent",
  "autosize": {
    "type": "pad",
    "contains": "padding"
  },
  "config": {
    "text": {
      "font": "'Source Sans 3', sans-serif",
      "fill": "#24281f"
    },
    "axis": {
      "labelFont": "'Source Sans 3', sans-serif",
      "titleFont": "'Source Sans 3', sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#4d5347",
      "titleColor": "#24281f",
      "domain": false,
      "ticks": false,
      "gridColor": "#e0dccf",
      "gridOpacity": 0.75,
      "labelPadding": 8,
      "titlePadding": 14
    },
    "legend": {
      "labelFont": "'Source Sans 3', sans-serif",
      "titleFont": "'Source Sans 3', sans-serif",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 500,
      "labelColor": "#4d5347",
      "titleColor": "#24281f",
      "gradientThickness": 9,
      "gradientLength": 130,
      "padding": 8
    }
  },
  "description": "Circular heatmap of monthly records per day relative to each state’s annual daily average. Rings show states from north to south; sectors follow the calendar.",
  "data": [
    {
      "name": "cells",
      "url": "https://wenshen18643.github.io/fit3179-fieldnotes/specs/data/every-state-keeps-its-own-busy-season-1.json"
    },
    {
      "name": "months",
      "values": [
        {
          "label": "Jan",
          "angle": 0.5551327211324828,
          "peak": false
        },
        {
          "label": "Feb",
          "angle": 1.0253981633974483,
          "peak": false
        },
        {
          "label": "Mar",
          "angle": 1.495663605662414,
          "peak": false
        },
        {
          "label": "Apr",
          "angle": 1.9659290479273794,
          "peak": false
        },
        {
          "label": "May",
          "angle": 2.436194490192345,
          "peak": false
        },
        {
          "label": "Jun",
          "angle": 2.9064599324573104,
          "peak": false
        },
        {
          "label": "Jul",
          "angle": 3.376725374722276,
          "peak": false
        },
        {
          "label": "Aug",
          "angle": 3.8469908169872413,
          "peak": false
        },
        {
          "label": "Sep",
          "angle": 4.317256259252207,
          "peak": false
        },
        {
          "label": "Oct",
          "angle": 4.787521701517173,
          "peak": true
        },
        {
          "label": "Nov",
          "angle": 5.257787143782139,
          "peak": false
        },
        {
          "label": "Dec",
          "angle": 5.728052586047104,
          "peak": false
        }
      ]
    },
    {
      "name": "rings",
      "values": [
        {
          "code": "NT",
          "r": 50.9375
        },
        {
          "code": "QLD",
          "r": 76.8125
        },
        {
          "code": "WA",
          "r": 102.6875
        },
        {
          "code": "SA",
          "r": 128.5625
        },
        {
          "code": "NSW",
          "r": 154.4375
        },
        {
          "code": "ACT",
          "r": 180.3125
        },
        {
          "code": "VIC",
          "r": 206.1875
        },
        {
          "code": "TAS",
          "r": 232.0625
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "pace",
      "type": "log",
      "domain": [
        0.5,
        1,
        2
      ],
      "range": [
        "#d01c8b",
        "#f7f7f7",
        "#4dac26"
      ],
      "clamp": true
    }
  ],
  "marks": [
    {
      "type": "arc",
      "from": {
        "data": "cells"
      },
      "encode": {
        "enter": {
          "x": {
            "value": 452
          },
          "y": {
            "value": 288
          },
          "startAngle": {
            "field": "a0"
          },
          "endAngle": {
            "field": "a1"
          },
          "innerRadius": {
            "field": "r0"
          },
          "outerRadius": {
            "field": "r1"
          },
          "fill": {
            "scale": "pace",
            "field": "dailyIndex"
          },
          "tooltip": {
            "signal": "{'State':datum.state,'Month':datum.label,'Records':format(datum.count,','),'Pace vs state’s usual day':format(datum.dailyIndex,'.2f')+'×'}"
          }
        },
        "update": {
          "strokeWidth": {
            "value": 0
          }
        },
        "hover": {
          "stroke": {
            "value": "#24281f"
          },
          "strokeWidth": {
            "value": 1.4
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "months"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "452+sin(datum.angle)*(datum.peak?257:269)"
          },
          "y": {
            "signal": "288-cos(datum.angle)*269"
          },
          "text": {
            "signal": "datum.peak?[datum.label,'busiest','nationwide']:datum.label"
          },
          "align": {
            "signal": "datum.peak?(sin(datum.angle)<0?'right':'left'):'center'"
          },
          "baseline": {
            "value": "middle"
          },
          "fontSize": {
            "signal": "datum.peak?13:12"
          },
          "fontWeight": {
            "signal": "datum.peak?700:400"
          },
          "fill": {
            "signal": "datum.peak?'#315e4c':'#24281f'"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "rings"
      },
      "encode": {
        "enter": {
          "x": {
            "value": 452
          },
          "y": {
            "signal": "288-datum.r"
          },
          "text": {
            "field": "code"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "fontSize": {
            "value": 11
          },
          "fill": {
            "value": "#4d5347"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {
            "value": 452
          },
          "y": {
            "value": 285
          },
          "text": {
            "value": "2024"
          },
          "align": {
            "value": "center"
          },
          "fontSize": {
            "value": 17
          },
          "fontWeight": {
            "value": 500
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {
            "value": 452
          },
          "y": {
            "value": 302
          },
          "text": {
            "value": "daily pace"
          },
          "align": {
            "value": "center"
          },
          "fontSize": {
            "value": 10
          },
          "fill": {
            "value": "#4d5347"
          }
        }
      }
    }
  ],
  "legends": [
    {
      "fill": "pace",
      "type": "gradient",
      "direction": "horizontal",
      "orient": "none",
      "legendX": 0,
      "legendY": 571,
      "title": "Records a day, compared with the state’s own average",
      "titleLimit": 864,
      "titleAnchor": "start",
      "values": [
        0.5,
        1,
        2
      ],
      "gradientLength": 220,
      "gradientThickness": 9,
      "encode": {
        "labels": {
          "update": {
            "text": {
              "signal": "datum.value===1?'usual':datum.value<1?'half or less':'double or more'"
            }
          }
        }
      }
    }
  ]
}
